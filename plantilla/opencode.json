{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.5-flash-lite",
  "small_model": "google/gemini-3.1-flash-lite",
  "providers": {
    "google": {
      "settings": {
        "headerTimeout": 60000,
        "chunkTimeout": 60000
      }
    }
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "python .opencode/skills/mi-calculo/scripts/calcular.py *", "effect": "allow" },
    { "action": "edit", "resource": "salidas/*", "effect": "ask" },
    { "action": "edit", "resource": "entradas/*", "effect": "deny" }
  ]
}
